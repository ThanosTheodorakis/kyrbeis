# Copy to .env and fill in. .env stays on this machine and is never committed.

# Your repository's https address
REPO_URL=https://github.com/YOUR-USERNAME/kyrbeis

# Fine-grained GitHub token: access to this repository only, "Contents: Read and write"
GITHUB_TOKEN=

# Daily collection time, Athens time (HH:MM). If the machine is off then, it runs when it starts.
RUN_AT=06:17

# Optional: how site owners can reach you (default: the repository's issues page)
# KYRBEIS_CONTACT=you@example.com
